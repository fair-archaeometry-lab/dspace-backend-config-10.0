<?xml version="1.0" encoding="UTF-8"?>
<dspace-dc-types>

    <!-- ORCID schema definition -->
    <schema>
        <name>orcid</name>
        <namespace>http://www.orcid.org/ns/record</namespace>
    </schema>

    <!-- =========
         TOP-LEVEL RECORD
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>record</element>
        <qualifier>path</qualifier>
        <scope_note>API path to the ORCID record</scope_note>
    </dc-type>

    <!-- ORCID identifier -->
    <dc-type>
        <schema>orcid</schema>
        <element>orcidIdentifier</element>
        <qualifier>uri</qualifier>
        <scope_note>Full ORCID URI (https://orcid.org/0000-000X-XXXX-XXXX)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>orcidIdentifier</element>
        <qualifier>path</qualifier>
        <scope_note>ORCID iD path (16-digit identifier)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>orcidIdentifier</element>
        <qualifier>host</qualifier>
        <scope_note>Host domain for the ORCID record</scope_note>
    </dc-type>

    <!-- =========
         PREFERENCES
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>preferences</element>
        <qualifier>locale</qualifier>
        <scope_note>Preferred display language/locale for the ORCID record</scope_note>
    </dc-type>

    <!-- =========
         HISTORY
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>creationMethod</qualifier>
        <scope_note>Method used to create the ORCID record (API, Direct, Member-referred)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>completionDate</qualifier>
        <scope_note>Date when the user took control of an API-created record</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>submissionDate</qualifier>
        <scope_note>Date when the ORCID record was first created</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>lastModifiedDate</qualifier>
        <scope_note>Last modification date of the ORCID record</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>claimed</qualifier>
        <scope_note>Whether the ORCID record has been claimed by its owner</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>verifiedEmail</qualifier>
        <scope_note>True if any email address on the record is verified</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>verifiedPrimaryEmail</qualifier>
        <scope_note>True if the current primary email is verified</scope_note>
    </dc-type>

    <!-- =========
         PERSON / PERSONAL DETAILS
         ========= -->

    <!-- Person container -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>path</qualifier>
        <scope_note>API path for the ORCID person section</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>lastModifiedDate</qualifier>
        <scope_note>Last modification date for the person section</scope_note>
    </dc-type>

    <!-- Name -->
    <dc-type>
        <schema>orcid</schema>
        <element>name</element>
        <qualifier>givenNames</qualifier>
        <scope_note>Given names of the researcher</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>name</element>
        <qualifier>familyName</qualifier>
        <scope_note>Family name (surname) of the researcher</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>name</element>
        <qualifier>creditName</qualifier>
        <scope_note>Preferred display name for credit/published form</scope_note>
    </dc-type>

    <!-- Biography -->
    <dc-type>
        <schema>orcid</schema>
        <element>biography</element>
        <qualifier>content</qualifier>
        <scope_note>Free-text biography describing the researcher’s career</scope_note>
    </dc-type>

    <!-- Other names -->
    <dc-type>
        <schema>orcid</schema>
        <element>otherNames</element>
        <qualifier>content</qualifier>
        <scope_note>Alternative names the researcher is or was known by</scope_note>
    </dc-type>

    <!-- Keywords -->
    <dc-type>
        <schema>orcid</schema>
        <element>keywords</element>
        <qualifier>content</qualifier>
        <scope_note>Keywords describing the researcher’s activities or interests</scope_note>
    </dc-type>

    <!-- Researcher URLs -->
    <dc-type>
        <schema>orcid</schema>
        <element>researcherUrls</element>
        <qualifier>urlName</qualifier>
        <scope_note>Display label for a site related to the researcher</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>researcherUrls</element>
        <qualifier>url</qualifier>
        <scope_note>URL of a site related to the researcher</scope_note>
    </dc-type>

    <!-- Emails -->
    <dc-type>
        <schema>orcid</schema>
        <element>emails</element>
        <qualifier>email</qualifier>
        <scope_note>Email address listed on the ORCID record</scope_note>
    </dc-type>

    <!-- Addresses -->
    <dc-type>
        <schema>orcid</schema>
        <element>addresses</element>
        <qualifier>country</qualifier>
        <scope_note>Country code associated with the person’s address</scope_note>
    </dc-type>

    <!-- Person external identifiers -->
    <dc-type>
        <schema>orcid</schema>
        <element>externalIdentifiers</element>
        <qualifier>externalIdType</qualifier>
        <scope_note>Type of personal identifier (e.g. Scopus Author ID, ResearcherID)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>externalIdentifiers</element>
        <qualifier>externalIdValue</qualifier>
        <scope_note>Value of the personal identifier</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>externalIdentifiers</element>
        <qualifier>externalIdUrl</qualifier>
        <scope_note>Resolvable URL for the personal identifier</scope_note>
    </dc-type>

    <!-- =========
         COMMON AFFILIATION FIELDS
         (used by education, employment, qualification, membership, service, invitedPosition, distinction)
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>affiliation</element>
        <qualifier>departmentName</qualifier>
        <scope_note>Department or unit name for the affiliation</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>affiliation</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Role title or position held in the affiliation</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>affiliation</element>
        <qualifier>startDate</qualifier>
        <scope_note>Start date of the affiliation</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>affiliation</element>
        <qualifier>endDate</qualifier>
        <scope_note>End date of the affiliation</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>affiliation</element>
        <qualifier>url</qualifier>
        <scope_note>URL associated with the affiliation</scope_note>
    </dc-type>

    <!-- Organization subfields -->
    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>name</qualifier>
        <scope_note>Name of the organization for the affiliation</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>city</qualifier>
        <scope_note>City of the organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>region</qualifier>
        <scope_note>Region/state of the organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>country</qualifier>
        <scope_note>Country code of the organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>disambiguatedOrganizationIdentifier</qualifier>
        <scope_note>Disambiguated organization identifier (e.g. ROR ID)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>disambiguationSource</qualifier>
        <scope_note>Source of the organization identifier (ROR, GRID, etc.)</scope_note>
    </dc-type>

    <!-- =========
         SPECIFIC AFFILIATION TYPES
         ========= -->

    <!-- Education -->
    <dc-type>
        <schema>orcid</schema>
        <element>education</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Degree or educational role title</scope_note>
    </dc-type>

    <!-- Employment -->
    <dc-type>
        <schema>orcid</schema>
        <element>employment</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Employment role title</scope_note>
    </dc-type>

    <!-- Qualification -->
    <dc-type>
        <schema>orcid</schema>
        <element>qualification</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Professional or vocational qualification title</scope_note>
    </dc-type>

    <!-- Membership -->
    <dc-type>
        <schema>orcid</schema>
        <element>membership</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Membership type or role</scope_note>
    </dc-type>

    <!-- Service -->
    <dc-type>
        <schema>orcid</schema>
        <element>service</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Service role (e.g. board member, volunteer officer)</scope_note>
    </dc-type>

    <!-- Invited position -->
    <dc-type>
        <schema>orcid</schema>
        <element>invitedPosition</element>
        <qualifier>roleTitle</qualifier>
        <scope_note>Title of invited position (honorary or visiting role)</scope_note>
    </dc-type>

    <!-- Distinction (pattern; exact XSD similar to other affiliations) -->
    <dc-type>
        <schema>orcid</schema>
        <element>distinction</element>
        <qualifier>title</qualifier>
        <scope_note>Award, prize, or other distinction title</scope_note>
    </dc-type>

    <!-- =========
         FUNDING
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>type</qualifier>
        <scope_note>Funding type (award, grant, contract, salary-award)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>organizationDefinedType</qualifier>
        <scope_note>Funders’ own subtype of funding</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>title</qualifier>
        <scope_note>Main title of the funding award</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>translatedTitle</qualifier>
        <scope_note>Translated title of the funding award</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>shortDescription</qualifier>
        <scope_note>Short description or abstract of the funding</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>amountCurrency</qualifier>
        <scope_note>Currency code for the funding amount</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>amountValue</qualifier>
        <scope_note>Numeric value of the funding amount</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>startDate</qualifier>
        <scope_note>Start date of the funding period</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>funding</element>
        <qualifier>endDate</qualifier>
        <scope_note>End date of the funding period</scope_note>
    </dc-type>

    <!-- =========
         WORKS
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>title</qualifier>
        <scope_note>Main title of the work</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>subtitle</qualifier>
        <scope_note>Subtitle of the work, if any</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>translatedTitle</qualifier>
        <scope_note>Translated title of the work</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>journalTitle</qualifier>
        <scope_note>Container title (journal, book, conference, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>shortDescription</qualifier>
        <scope_note>Short description or abstract of the work</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>citationType</qualifier>
        <scope_note>Format of the work citation (BibTeX, RIS, APA, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>citationValue</qualifier>
        <scope_note>Content of the work citation in the chosen format</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>type</qualifier>
        <scope_note>Type of the work (article, dataset, book, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>publicationDate</qualifier>
        <scope_note>Publication date of the work (fuzzy date)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>url</qualifier>
        <scope_note>URL pointing to the work</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>languageCode</qualifier>
        <scope_note>Language of the work metadata</scope_note>
    </dc-type>

    <!-- =========
         PEER REVIEW
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>reviewerRole</qualifier>
        <scope_note>Role of the person in the peer review (reviewer, editor, chair, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>reviewType</qualifier>
        <scope_note>Type of review (review or evaluation)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>reviewCompletionDate</qualifier>
        <scope_note>Date the review was completed</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>subjectType</qualifier>
        <scope_note>Type of object that was reviewed (e.g. journal article, grant)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>subjectContainerName</qualifier>
        <scope_note>Journal, conference, or panel name containing the reviewed subject</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>peerReview</element>
        <qualifier>subjectNameTitle</qualifier>
        <scope_note>Title of the object that was reviewed</scope_note>
    </dc-type>

    <!-- =========
         RESEARCH RESOURCES
         ========= -->

    <dc-type>
        <schema>orcid</schema>
        <element>researchResource</element>
        <qualifier>proposalTitle</qualifier>
        <scope_note>Title of the proposal that led to resource access</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>researchResource</element>
        <qualifier>proposalStartDate</qualifier>
        <scope_note>Start date of the resource access period</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>researchResource</element>
        <qualifier>proposalEndDate</qualifier>
        <scope_note>End date of the resource access period</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>researchResource</element>
        <qualifier>resourceItemName</qualifier>
        <scope_note>Name of an actual research resource used</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>researchResource</element>
        <qualifier>resourceItemType</qualifier>
        <scope_note>Type of resource (collections, equipment, infrastructures, services)</scope_note>
    </dc-type>

</dspace-dc-types>