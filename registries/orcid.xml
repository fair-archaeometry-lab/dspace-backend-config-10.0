<?xml version="1.0" encoding="UTF-8"?>
<dspace-dc-types>

    <!-- Schema -->
    <schema>
        <name>orcid</name>
        <namespace>http://orcid.org/schema/record</namespace>
    </schema>

    <!-- ORCID IDENTIFIER -->
    <dc-type>
        <schema>orcid</schema>
        <element>identifier</element>
        <qualifier>uri</qualifier>
        <scope_note>Full ORCID URI (e.g. https://orcid.org/0000-0002-1825-0097)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>identifier</element>
        <qualifier>path</qualifier>
        <scope_note>16-digit ORCID identifier</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>identifier</element>
        <qualifier>host</qualifier>
        <scope_note>Domain hosting the ORCID record (e.g. orcid.org)</scope_note>
    </dc-type>

    <!-- RECORD METADATA -->
    <dc-type>
        <schema>orcid</schema>
        <element>preferences</element>
        <qualifier>locale</qualifier>
        <scope_note>Preferred language of the ORCID record (ISO 639-1 code)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>creation_method</qualifier>
        <scope_note>Method used to create the record (Direct, Website, Member-referred, API)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>submission_date</qualifier>
        <scope_note>Date the ORCID record was created or claimed</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>last_modified_date</qualifier>
        <scope_note>Last modification timestamp of the record</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>claimed</qualifier>
        <scope_note>Indicates whether the ORCID record is claimed by the researcher (true/false)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>history</element>
        <qualifier>verified_email</qualifier>
        <scope_note>Indicates if any email address is verified</scope_note>
    </dc-type>

    <!-- PERSON: NAMES -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>given_names</qualifier>
        <scope_note>Researcher's first or given names</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>family_name</qualifier>
        <scope_note>Researcher's last or family name</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>credit_name</qualifier>
        <scope_note>Full display name preferred by the researcher</scope_note>
    </dc-type>

    <!-- OTHER NAMES -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>other_name</qualifier>
        <scope_note>Alternative names or aliases of the researcher (repeatable)</scope_note>
    </dc-type>

    <!-- BIOGRAPHY -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>biography</qualifier>
        <scope_note>Free-text biography written by the researcher</scope_note>
    </dc-type>

    <!-- RESEARCHER URLS -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>url</qualifier>
        <scope_note>External website URL related to the researcher</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>url_name</qualifier>
        <scope_note>Label or name of the external URL</scope_note>
    </dc-type>

    <!-- EMAIL -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>email</qualifier>
        <scope_note>Email address associated with the ORCID record (may be restricted by visibility)</scope_note>
    </dc-type>

    <!-- ADDRESS -->
    <dc-type>
        <schema>orcid</schema>
        <element>address</element>
        <qualifier>country</qualifier>
        <scope_note>Country where the researcher is active (ISO 3166-1 alpha-2)</scope_note>
    </dc-type>

    <!-- KEYWORDS -->
    <dc-type>
        <schema>orcid</schema>
        <element>person</element>
        <qualifier>keyword</qualifier>
        <scope_note>Keywords describing research interests (repeatable)</scope_note>
    </dc-type>

    <!-- EXTERNAL IDENTIFIERS -->
    <dc-type>
        <schema>orcid</schema>
        <element>external_identifier</element>
        <qualifier>type</qualifier>
        <scope_note>Type of external identifier (e.g. DOI, Scopus ID)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>external_identifier</element>
        <qualifier>value</qualifier>
        <scope_note>Identifier value</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>external_identifier</element>
        <qualifier>url</qualifier>
        <scope_note>Resolvable URL for the identifier</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>external_identifier</element>
        <qualifier>relationship</qualifier>
        <scope_note>Relationship of identifier (self, part-of, version-of)</scope_note>
    </dc-type>

    <!-- ORGANIZATION (USED IN EDUCATION, EMPLOYMENT, FUNDING) -->
    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>name</qualifier>
        <scope_note>Name of the affiliated organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>city</qualifier>
        <scope_note>City of the organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>region</qualifier>
        <scope_note>Region/state of the organization</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>country</qualifier>
        <scope_note>Country of the organization (ISO code)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>identifier</qualifier>
        <scope_note>Disambiguated organization identifier (e.g. ROR, GRID, LEI)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>organization</element>
        <qualifier>identifier_source</qualifier>
        <scope_note>Source of organization identifier (ROR, GRID, Crossref)</scope_note>
    </dc-type>

    <!-- ACTIVITIES: EMPLOYMENT / EDUCATION -->
    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>type</qualifier>
        <scope_note>Type of activity (education, employment, funding, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>role_title</qualifier>
        <scope_note>Position or role held by the researcher</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>department</qualifier>
        <scope_note>Department within the organization</scope_note>
    </dc-type>

    <!-- DATES -->
    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>start_year</qualifier>
        <scope_note>Start year of the activity</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>start_month</qualifier>
        <scope_note>Start month of the activity</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>start_day</qualifier>
        <scope_note>Start day of the activity</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>end_year</qualifier>
        <scope_note>End year of the activity (or ongoing if empty)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>end_month</qualifier>
        <scope_note>End month of the activity</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>activity</element>
        <qualifier>end_day</qualifier>
        <scope_note>End day of the activity</scope_note>
    </dc-type>

    <!-- WORKS -->
    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>title</qualifier>
        <scope_note>Title of a research output</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>type</qualifier>
        <scope_note>Type of work (journal-article, book, dataset, etc.)</scope_note>
    </dc-type>

    <dc-type>
        <schema>orcid</schema>
        <element>work</element>
        <qualifier>doi</qualifier>
        <scope_note>Digital Object Identifier of the work</scope_note>
    </dc-type>

</dspace-dc-types>
