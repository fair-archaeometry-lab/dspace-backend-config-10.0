    <dc-type>
        <schema>georem</schema>
        <element>citation</element>
        <qualifier>publicationYear</qualifier>
        <scope_note>Year in which the publication was released.</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>citation</element>
        <qualifier>citationShort</qualifier>
        <scope_note>Abbreviated citation used for concise display.</scope_note>
