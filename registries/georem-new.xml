    <!-- citation -->
    <dc-type>
        <schema>georem</schema>
        <element>citation</element>
        <qualifier>identifier</qualifier>
        <scope_note>Persistent identifier assigned to the publication.</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>citation</element>
        <qualifier>identifierType</qualifier>
        <scope_note>Type of persistent identifier used for the publication (e.g. DOI, Handle, ISBN).</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>citation</element>
        <qualifier>title</qualifier>
        <scope_note>Title of the publication describing the analytical data or reference material.</scope_note>
