<?xml version="1.0" encoding="UTF-8"?>
<dspace-dc-types>

    <!-- Schema -->
    <schema>
        <name>georem</name>
        <namespace>http://georem.org/schema</namespace>
    </schema>

    <!-- SAMPLE / MATERIAL -->
    <dc-type>
        <schema>georem</schema>
        <element>sample</element>
        <qualifier>name</qualifier>
        <scope_note>Name of the reference material or sample (e.g., BHVO-2, NIST SRM 610)</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>sample</element>
        <qualifier>type</qualifier>
        <scope_note>Type of material (rock, glass, mineral, water, isotopic standard)</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>sample</element>
        <qualifier>origin</qualifier>
        <scope_note>Institution or program providing the reference material (e.g., USGS, NIST, MPI-DING)</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>sample</element>
        <qualifier>description</qualifier>
        <scope_note>Free-text description of the sample or material</scope_note>
    </dc-type>

    <!-- ANALYTE / CHEMISTRY -->
    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>analyte</qualifier>
        <scope_note>Chemical element or isotope measured (e.g., SiO2, Pb206/Pb204)</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>value</qualifier>
        <scope_note>Measured concentration or isotope ratio value</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>unit</qualifier>
        <scope_note>Measurement unit (e.g., wt%, ppm, ppb, ratio)</scope_note>
    </dc-type>

    <!-- UNCERTAINTY -->
    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>uncertainty</qualifier>
        <scope_note>Reported analytical uncertainty associated with the value</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>uncertainty_type</qualifier>
        <scope_note>Type of uncertainty (e.g., standard deviation, standard error, confidence interval)</scope_note>
    </dc-type>

    <!-- ANALYTICAL METHOD -->
    <dc-type>
        <schema>georem</schema>
        <element>method</element>
        <qualifier>name</qualifier>
        <scope_note>Analytical technique used (e.g., ICP-MS, XRF, TIMS, LA-ICP-MS)</scope_note>
    </dc-type>

    <!-- LABORATORY -->
    <dc-type>
        <schema>georem</schema>
        <element>laboratory</element>
        <qualifier>name</qualifier>
        <scope_note>Name of the laboratory where the analysis was performed</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>laboratory</element>
        <qualifier>location</qualifier>
        <scope_note>Geographic location of the laboratory</scope_note>
    </dc-type>

    <!-- RESULT GROUPING -->
    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>dataset_id</qualifier>
        <scope_note>Identifier linking a set of analytical results belonging to the same measurement campaign</scope_note>
    </dc-type>

    <!-- REFERENCE / BIBLIOGRAPHY -->
    <dc-type>
        <schema>georem</schema>
        <element>reference</element>
        <qualifier>citation</qualifier>
        <scope_note>Full bibliographic citation of the publication reporting the data</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>reference</element>
        <qualifier>doi</qualifier>
        <scope_note>Digital Object Identifier of the publication</scope_note>
    </dc-type>

    <dc-type>
        <schema>georem</schema>
        <element>reference</element>
        <qualifier>year</qualifier>
        <scope_note>Year of publication</scope_note>
    </dc-type>

    <!-- DATA QUALITY -->
    <dc-type>
        <schema>georem</schema>
        <element>analysis</element>
        <qualifier>quality_flag</qualifier>
        <scope_note>Indicator of data quality or validation status</scope_note>
    </dc-type>

</dspace-dc-types>
